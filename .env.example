# Salin menjadi .env lalu isi password database:  cp .env.example .env
# File .env rahasia (sudah di .gitignore). Variabel sama dengan versi lama, jadi .env lama tetap bisa dipakai.

APP_BIND_IP=0.0.0.0
APP_PORT=8090

APP_NAME="Absensi Sekolah"
# Alamat publik, mis. https://absen.sekolah.sch.id (dipakai untuk tautan). Kosong = http://localhost.
APP_BASE_URL=
APP_TIMEZONE=Asia/Makassar
APP_DEBUG=false
# Kosongkan: kunci aplikasi dibuat otomatis dan disimpan di volume storage.
APP_KEY=

DB_NAME=absensi_sekolah
DB_USER=absensi
DB_PASSWORD=
DB_ROOT_PASSWORD=
